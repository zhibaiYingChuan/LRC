*.profraw
*.profdata
perf.data
flamegraph.svg

# 压缩文件
*.tar.gz
*.zip
*.7z

# macOS 应用签名
*.app/

# 代码签名相关（本地开发用，不入库）
*.p12
*.pem
*.key
*.crt
*.mobileprovision