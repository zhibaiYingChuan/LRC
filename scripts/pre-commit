#!/bin/bash
# ============================================================
# Loong Recall (L-RC / 忆) - 预提交钩子
# ============================================================
# 每次提交前自动运行核心算法泄露检测，防止受保护代码
# 意外泄露到公开层文件。
#
# 遵循 DaoTi 分层开源协议：
#   Layer 1 (Public)  — Apache 2.0
#   Layer 2 (Protected) — DaoTi Research License v1.0
# ============================================================

set -e

echo "============================================================"
echo "  Loong Recall 预提交检查"
echo "============================================================"

# 1. Rust 编译检查（仅检查公开层 + 服务层编译）
echo ""
echo "[1/3] Rust 编译检查..."
cargo check --features server 2>&1 || {
    echo "  编译失败！请修复编译错误后再提交。"
    exit 1
}
echo "  编译通过。"

# 2. 测试
echo ""
echo "[2/3] 运行单元测试..."
cargo test 2>&1 || {
    echo "  测试失败！请修复测试后再提交。"
    exit 1
}
echo "  测试通过。"

# 3. 核心算法泄露检测
echo ""
echo "[3/3] 核心算法泄露检测..."
PYTHON_CMD=""
for cmd in py python3 python; do
    if command -v "$cmd" > /dev/null 2>&1 && $cmd -c "print('ok')" > /dev/null 2>&1; then
        PYTHON_CMD="$cmd"
        break
    fi
done
if [ -z "$PYTHON_CMD" ]; then
    echo ""
    echo "  警告: 未找到 Python 解释器，跳过泄露检测"
    echo "  请确保已安装 Python 3 并加入 PATH"
else
    $PYTHON_CMD scripts/check_algorithm_leak.py || {
    echo ""
    echo "  泄露检测未通过！"
    echo "  请确保公开层文件中不包含受保护的核心算法逻辑。"
    echo "  公开层文件: src/chunker.rs, src/server.rs, src/bin/server.rs, src/lib.rs"
    exit 1
}
fi

echo ""
echo "============================================================"
echo "  预提交检查全部通过！"
echo "============================================================"