#!/bin/bash
# ============================================================
# Loong Recall (L-RC / 忆) - 预提交钩子（v2.1 版本控制版）
# ============================================================
# 每次提交前自动运行 5 项检查，确保代码质量与 CI 对齐：
#   1. cargo fmt --check      — 代码格式（与 CI Rustfmt job 对齐）
#   2. cargo clippy           — 静态检查（与 CI Clippy job 对齐）
#   3. cargo check            — 编译验证
#   4. cargo test             — 单元测试
#   5. 算法泄露检测            — DaoTi 分层开源协议合规
#
# v2.1 变更（2026-09-12，审查修复 D-11）：
#   - 本文件纳入版本控制（原仅存在于 .git/hooks/pre-commit，不可分发）
#   - REPO_ROOT 解析由 "../.." 改为 ".."，适配 .githooks/ 一层目录结构
#   - 启用方式：git config --local core.hooksPath .githooks
#     （或运行 scripts/enable_git_hooks.ps1 自动启用）
#   - 保留 .git/hooks/pre-commit 兼容路径：若直接安装到 .git/hooks/，
#     REPO_ROOT 解析会失配，请统一使用 .githooks/ 方式
#
# v2.0 变更（2026-07-30）：
#   - 新增 cargo fmt --check（修复 v0.8.7 CI fmt 失败遗漏）
#   - 新增 cargo clippy -D warnings（修复 v0.8.7 CI Clippy 失败遗漏）
#   - 修复 Windows Git Bash cargo PATH 问题
# ============================================================

# 注意：不使用 set -e —— 所有检查已用 || { ...; exit 1; } 显式错误处理
# set -e 会导致 echo 在某些环境（如 PowerShell 调用 Git Bash）下遇到
# "Bad file descriptor" 时提前退出，吞掉真实错误信息

# 确保 cargo 在 PATH 中（Windows Git Bash 兼容）
export PATH="$HOME/.cargo/bin:$PATH"

# 验证 cargo 可用
if ! command -v cargo > /dev/null 2>&1; then
    echo "  错误: cargo 不在 PATH 中，无法运行预提交检查"
    echo "  请确保 Rust 已安装，或手动运行: export PATH=\"\$HOME/.cargo/bin:\$PATH\""
    exit 1
fi

# 获取仓库根目录
# v2.1 修复：本钩子位于 .githooks/（仓库根下一层），故向上 ".." 即仓库根。
# 原 ".git/hooks/" 位于仓库根下两层，需要 "../.."；两者不可混用。
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

echo "============================================================"
echo "  Loong Recall 预提交检查（v2.1）"
echo "============================================================"

# 1. 代码格式检查（与 CI Rustfmt job 对齐）
echo ""
echo "[1/5] 代码格式检查 (cargo fmt)..."
cargo fmt --all -- --check 2>&1 || {
    echo "  格式检查失败！请运行 'cargo fmt --all' 修复格式后再提交。"
    exit 1
}
echo "  格式通过。"

# 2. Clippy 静态检查（与 CI Clippy job 对齐，-D warnings 拒绝所有警告）
echo ""
echo "[2/5] Clippy 静态检查..."
cargo clippy --features server -- -D warnings 2>&1 || {
    echo "  Clippy 检查失败！请修复 lint 错误后再提交。"
    echo "  提示: 运行 'cargo clippy --features server --fix' 自动修复"
    exit 1
}
cargo clippy --all-targets -- -D warnings 2>&1 || {
    echo "  Clippy (all-targets) 检查失败！请修复 lint 错误后再提交。"
    exit 1
}
echo "  Clippy 通过。"

# 3. Rust 编译检查
echo ""
echo "[3/5] Rust 编译检查..."
cargo check --features server 2>&1 || {
    echo "  编译失败！请修复编译错误后再提交。"
    exit 1
}
echo "  编译通过。"

# 4. 测试
echo ""
echo "[4/5] 运行单元测试..."
cargo test 2>&1 || {
    echo "  测试失败！请修复测试后再提交。"
    exit 1
}
echo "  测试通过。"

# 5. 核心算法泄露检测
echo ""
echo "[5/5] 核心算法泄露检测..."

# 查找 Python 解释器（避免 Microsoft Store 重定向陷阱）
PYTHON_CMD=""
for cmd in python3 python py; do
    if command -v "$cmd" > /dev/null 2>&1; then
        # 验证 Python 能正常工作（排除 Microsoft Store 重定向）
        PYTHON_OUT="$($cmd -c "import sys; print(sys.executable)" 2>/dev/null)" || true
        if [ -n "$PYTHON_OUT" ] && [ "$PYTHON_OUT" != "python.exe" ]; then
            PYTHON_CMD="$cmd"
            break
        fi
    fi
done

if [ -z "$PYTHON_CMD" ]; then
    echo ""
    echo "  警告: 未找到可用的 Python 3 解释器，跳过泄露检测"
    echo "  请确保已安装 Python 3 并加入 PATH"
else
    echo "  使用 Python: $($PYTHON_CMD --version 2>&1)"

    LEAK_SCRIPT="$REPO_ROOT/scripts/check_algorithm_leak.py"

    if [ ! -f "$LEAK_SCRIPT" ]; then
        echo "  错误: 找不到泄露检测脚本: $LEAK_SCRIPT"
        exit 1
    fi

    set +e
    $PYTHON_CMD "$LEAK_SCRIPT"
    LEAK_EXIT_CODE=$?

    if [ $LEAK_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "  泄露检测未通过！"
        echo "  公开层文件: src/chunker.rs, src/server.rs, src/bin/server.rs, src/lib.rs"
        echo "  提示: 运行 'python scripts/check_algorithm_leak.py --verbose' 查看详情"
        exit 1
    fi
fi

# v0.8.9 修复：末尾显式 exit 0
# 原因：PowerShell 调用 Git Bash 时，末尾 echo 可能遇到 "Bad file descriptor"
# 失败，导致脚本退出码变为 1（最后一个命令的退出码），即使所有检查都通过。
# 显式 exit 0 确保所有检查通过后，无论 echo 是否成功，提交都能继续。
echo ""
echo "============================================================"
echo "  预提交检查全部通过！（fmt + clippy + check + test + 泄露检测）"
echo "============================================================"

exit 0
